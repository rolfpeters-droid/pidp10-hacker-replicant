# Copy this file to .env and fill in what you need.
# server.js loads these via `systemd EnvironmentFile=` or any other .env
# loader you prefer -- it just reads process.env, nothing is bundled in.

# --- Networking ---
PORT=8099
# Where the machine's own web console lives. Shown in the left panel and
# the "back" link.
CONSOLE_URL=http://localhost:8080

# Where the two Hacker Replicant routes (GET /screen, POST /keys, and
# optionally GET /status) are reachable, under this base path.
#
# Unlike some of the sibling Hacker Replicants (PiDP-8/I, PiDP-11), there is
# NO bundled standalone boot-API script in this repo for the PiDP-10. The
# machine this was built against drives its console over a telnet-backed
# line buffer rather than a `screen` session, and that state lives inside
# the PiDP-10's own existing web console process -- so the cleanest place
# for these two routes turned out to be *inside* that process, not a tiny
# separate script. See README.md ("Wiring up machine control") for the
# worked example and how to adapt it.
#
# Point this at wherever you've added those routes:
#   - Your own PiDP-10 web console, with the two routes added to it
#     (the README's worked example assumes this).
#   - A tiny standalone script, if your setup drives the console via GNU
#     `screen` instead of telnet -- see the sibling PiDP-11/PiDP-8i repos
#     for that pattern (`screen -X stuff` / `screen -X hardcopy`), which
#     ports over directly.
BOOTAPI_BASE=http://localhost:8080/api/pidp10

# --- Control toggle ---
# How many send_keys/read_screen calls the agent gets per turn before it has
# to ask in plain text whether it may continue.
ACTION_LIMIT=5

# --- Local backend (default, free) ---
# Any OpenAI-compatible endpoint. A stock Ollama install already speaks this
# API at /v1 -- nothing extra to configure if you're running Ollama with the
# default settings and have pulled a model that supports tool calling
# (qwen3, llama3.1+, mistral-nemo, etc. all do).
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=
LOCAL_MODEL=qwen3:14b

# --- Cloud backend (optional, for a faster/smarter option) ---
# Any OpenAI-compatible hosted provider: OpenAI itself, Groq, Together,
# Fireworks, DeepSeek, Mistral, OpenRouter, a hosted vLLM/TGI endpoint, etc.
# Leave CLOUD_BASE_URL empty to disable the cloud toggle -- it will just
# return a clear error telling the user to configure it, instead of
# silently falling back to local.
#
# Examples:
#   OpenAI:      CLOUD_BASE_URL=https://api.openai.com/v1        CLOUD_MODEL=gpt-4o-mini
#   Groq:        CLOUD_BASE_URL=https://api.groq.com/openai/v1   CLOUD_MODEL=llama-3.3-70b-versatile
#   OpenRouter:  CLOUD_BASE_URL=https://openrouter.ai/api/v1     CLOUD_MODEL=<any tool-calling model on OpenRouter>
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=
